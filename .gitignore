# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/
venv/
env/

# Django static (compiled output)
staticfiles/

# Allow compiled tailwind css to be committed
!static/css/dist/

# Tailwind CLI
.django_tailwind_cli
./.django_tailwind_cli

# ── DATABASE FILES ────────────────────────────────────────────────────────────
# db.sqlite3 tracked as requested
db.sqlite3-shm
db.sqlite3-wal
db.sqlite3.*
*.sqlite3.bak
*.sqlite3.bak*
*.db

# ── MEDIA / USER UPLOADS (NEVER COMMIT) ──────────────────────────────────────
media/*
!media/.gitkeep

# ── ENVIRONMENT / SECRETS ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.keystore
*.jks
*.p12

# ── LOGS ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── CACHE / GENERATED ────────────────────────────────────────────────────────
.cache/
*.cache
celerybeat-schedule
celerybeat.pid

# ── NODE / FRONTEND ──────────────────────────────────────────────────────────
node_modules/

# ── OS / EDITOR ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── BACKUP / RUNTIME DUMP FILES ──────────────────────────────────────────────
*.bak
*.backup
backups/files/
backups.zip
backups/*.zip
backups/*.tar
backups/*.tar.gz
backups/*.dump
*.dump
