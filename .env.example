# ==============================================================================
# FieldTrack Django Application - Environment Configuration Template
# Domain: https://trackme.signtechlimited.com
# ==============================================================================

# Core Django Settings
DEBUG=False
PORT=8000
SECRET_KEY=change_me_to_a_secure_random_string_min_32_chars_in_production

# Host and Origin Security
ALLOWED_HOSTS=trackme.signtechlimited.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://trackme.signtechlimited.com,http://trackme.signtechlimited.com

# PostgreSQL Production Database Configuration
# Internal URL format:
DATABASE_URL=postgres://trackme:%23trackme%40@nj4qq0ypkmauaqd4nhh0eqmt:5432/postgres
DB_NAME=trackme
# Alternatively, discrete parameters:
# DB_HOST=nj4qq0ypkmauaqd4nhh0eqmt
# DB_PORT=5432
# DB_USER=trackme
# DB_PASSWORD=#trackme@
# DB_NAME=trackme

# Database Connection Pooling (seconds)
DB_CONN_MAX_AGE=600

# SQLite Local Development / Fallback Configuration
SQLITE_PATH=db.sqlite3
SQLITE_TIMEOUT=20.0

# HTTPS & Transport Security (Active behind Reverse Proxy / Coolify / Traefik / Nginx)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER_ENABLED=True
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# Multi-Tenancy Configuration
TENANCY_ENABLED=True
TENANT_UI_ENABLED=False
DEFAULT_TENANT_SLUG=signtech

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@fieldtrack.com
