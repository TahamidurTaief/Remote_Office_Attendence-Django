# Django Application Configuration Template
# Copy this file to .env and adjust the values for your environment.

DEBUG=True
SECURE_SSL_REDIRECT=False
SECRET_KEY=change_me_to_a_secure_random_string_in_production

# Database Configuration (Defaults to SQLite in local development if omitted)
# DATABASE_URL=postgres://user:password@localhost:5432/fieldtrack_db

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Android TWA Signing Certificate Fingerprint (SHA-256)
# Generate with: keytool -list -v -keystore <keystore-path> -alias <alias>
TWA_SHA256_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
