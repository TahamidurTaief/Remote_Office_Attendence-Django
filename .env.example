# ==============================================================================
# FieldTrack Django Application - Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# Core Django Settings
DEBUG=True
# In production (DEBUG=False), DJANGO_SECRET_KEY is mandatory (min 32 characters)
DJANGO_SECRET_KEY=change_me_to_a_secure_random_string_min_32_chars_in_production

# Host and Origin Security
# Comma-separated list of valid host/domain names
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (SQLite Runtime Lock)
# SQLite is active and locked for this delivery phase.
# SQLITE_PATH=db.sqlite3
# SQLITE_TIMEOUT=5.0

# Future PostgreSQL Configuration (INACTIVE - requires migration gate approval):
# DATABASE_URL=postgres://user:password@localhost:5432/fieldtrack_db

# HTTPS & Transport Security (Active in Production / DEBUG=False)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER_ENABLED=True
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# Multi-Tenancy Configuration
TENANCY_ENABLED=True
TENANT_UI_ENABLED=False
DEFAULT_TENANT_SLUG=signtech

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@fieldtrack.com

# Android TWA Signing Certificate Fingerprint (SHA-256)
# Generate via: keytool -list -v -keystore <keystore-path> -alias <alias>
TWA_SHA256_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
