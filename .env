DEBUG=True
SECURE_SSL_REDIRECT=False

SECRET_KEY=CHANGE_ME_generate_a_real_random_secret_key_before_production

# Replace with your actual PostgreSQL database credentials
# DATABASE_URL=postgres://user:password@localhost:5432/fieldtrack_db

# Using sqlite for initial setup to allow migrations to run

ALLOWED_HOSTS=trackme.signtechlimited.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://trackme.signtechlimited.com

# SHA-256 signing certificate fingerprint for the Android TWA app.
# Get it via: keytool -list -v -keystore android.keystore -alias android
# Copy the "SHA256:" value (with colons) here — required for the app to
# open full-screen (Digital Asset Links verification).
TWA_SHA256_FINGERPRINT=REPLACE_WITH_REAL_SHA256_FINGERPRINT
